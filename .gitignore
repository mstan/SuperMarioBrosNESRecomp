# Local build trees and release staging
build/
build-*/
build_*/
release/
release-*/
release_*/
cmake-build-*/
/CMakeUserPresets.json

# Runtime state, private configuration, ROMs, and captures
widescreen.ini
_ws_build.bat
*.nes
*.bin
*.sav
*.log
*.zip
*.AppImage
*.dmg
.mcp.json
debug.ini
rom.cfg
*.srm
mods/state.toml
