# Ghidra databases stay local; share human annotation exports instead.
*.gpr
*.rep/
/ghidra/*.lock
/ghidra/*.lock~
!ghidra/annotations/
!ghidra/annotations/**

# Recompiler regen audit byproducts (regenerated on every NESRecomp run)
generated/*_coverage.txt
*_auto_entries.csv
*_finder_audit.csv

# HD texture pack (user-supplied Mesen HD pack dropped in <exe>/hdpack)
hdpack/

nestopia-core

# Local Python tooling bytecode
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Editor and OS metadata
.vs/
.DS_Store
Thumbs.db

# Falcon harness build byproducts (traces are regenerated, not tracked)
tests/falcon_harness/*.exe
tests/falcon_harness/*.obj
tests/falcon_harness/trace_*.csv

# SSB64 owner ROM + locally generated/cache assets. Never commit or package.
assets_ssb64/
_external/
_validation/
_validation_genesis/
