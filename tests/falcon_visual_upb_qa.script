WAIT 25
SCREENSHOT C:/temp/falcon_upb_throw_40.png
WAIT 19
SCREENSHOT C:/temp/falcon_upb_throw_59.png
DUMP_RAM 000F 20
ASSERT_RAM8 000E 08
LOAD_STATE C:/temp/falcon_upb_catch_active.sav
SCREENSHOT C:/temp/falcon_upb_catch_reloaded.png
WAIT 2
LOAD_STATE C:/temp/falcon_upb_contact_pending.sav
WAIT 3
