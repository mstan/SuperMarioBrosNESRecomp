# Adapter v5 preserves the subpixel departure bridge. From this saved startup
# point, seven resumed script frames reach FalconDive's frame-13 root burst.
LOAD_STATE C:/temp/falcon_upb_departure_latch.sav
ASSERT_RAM8 00CE B0
WAIT 7
ASSERT_RAM8 00CE A6

# A clean miss must visibly use FallSpecial, then the source's forced
# LandingFallSpecial route at 0.65x rather than ordinary landing recovery.
LOAD_STATE C:/temp/falcon_upb_right_base.sav
