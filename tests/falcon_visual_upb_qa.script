WAIT 2

# One supported Goomba in the launch catch union. The adapter must defeat only
# slot 0 once, leave the overlapping slot 1 target alone, then Falcon must
# visibly play Catch and Throw. Spawn both at source frame 12 so ordinary SMB
# movement cannot carry them out of the one-frame forward tip before it opens.
LOAD_STATE C:/temp/falcon_upb_contact_base.sav
WAIT 2
HOLD UP
HOLD B
WAIT 2
RELEASE B
RELEASE UP
WAIT 11
WRITE_RAM8 000F 01
WRITE_RAM8 0010 01
WRITE_RAM8 0016 06
WRITE_RAM8 0017 06
WRITE_RAM8 001E 00
WRITE_RAM8 001F 00
WRITE_RAM8 006E 00
WRITE_RAM8 006F 00
WRITE_RAM8 0087 3C
WRITE_RAM8 0088 3C
WRITE_RAM8 00B6 01
WRITE_RAM8 00B7 01
WRITE_RAM8 00CF 80
WRITE_RAM8 00D0 80
WAIT 2
SCREENSHOT C:/temp/falcon_upb_contact_13.png
WAIT 2
WAIT 2
DUMP_RAM 001E 02
# SMB's ordinary enemy update advances both fresh Goombas to state 1 before
# the catch check. Slot 1 must remain there; the stale-volume regression set
# its defeated bit and produced a second FALCON_DIVE_CATCH combat event.
ASSERT_RAM8 001F 01
WAIT 1
DUMP_RAM 001E 02
ASSERT_RAM8 001F 01
WAIT 2
DUMP_RAM 001E 02
ASSERT_RAM8 001F 01
WAIT 3
DUMP_RAM 001E 02
ASSERT_RAM8 001F 01
WAIT 2
DUMP_RAM 001E 02
# Slot 1 is the first still-overlapping target after SMB's movement step in
# this deterministic setup. Exactly it is defeated; slot 0 remains ordinary.
ASSERT_RAM8 001E 01
ASSERT_RAM8 001F 22
# This snapshot is deliberately between the native one-target defeat and the
# next controller resolve. It covers AdapterSaveFields.contact_pending.
SAVE_STATE C:/temp/falcon_upb_contact_pending.sav
# Drain the adapter's one-shot confirmation into Falcon before snapshotting,
# so this is a real Catch-state save rather than a pending native contact.
WAIT 2
SAVE_STATE C:/temp/falcon_upb_catch_active.sav
SCREENSHOT C:/temp/falcon_upb_catch_01.png
