LOG link-smoke
WAIT 60
HOLD START
WAIT 6
RELEASE START
WAIT_RAM8 000E 08
WAIT 90

# Zelda II B sword should not leak to SMB run/fireball handling; it should
# drive Link's controller slash state through the shared adapter.
HOLD B
WAIT 2
RELEASE B
WAIT_FOREIGN_STATE Slash
WAIT 8

HOLD DOWN
WAIT 4
HOLD B
WAIT 2
RELEASE B
WAIT_FOREIGN_STATE CrouchSlash
RELEASE DOWN
WAIT 20

HOLD A
WAIT 2
RELEASE A
WAIT_FOREIGN_STATE Jump
HOLD UP
HOLD B
WAIT 2
RELEASE B
WAIT_FOREIGN_STATE UpStab
RELEASE UP
WAIT 6

HOLD DOWN
HOLD B
WAIT 2
RELEASE B
WAIT_FOREIGN_STATE DownStab
RELEASE DOWN
WAIT 20
EXIT 0
