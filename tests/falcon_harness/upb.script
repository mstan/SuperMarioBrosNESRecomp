expect_enemy_policy 0x09 0x00 1
expect_enemy_policy 0x0A 0x00 1
expect_enemy_policy 0x0B 0x00 1
expect_enemy_policy 0x0C 0x00 0
expect_enemy_policy 0x0D 0x00 1
expect_enemy_policy 0x0E 0x00 1
expect_enemy_policy 0x0F 0x00 1
expect_enemy_policy 0x10 0x00 1
expect_enemy_policy 0x11 0x00 1
expect_enemy_policy 0x12 0x00 1
expect_enemy_policy 0x13 0x00 1
expect_enemy_policy 0x14 0x00 1
expect_enemy_policy 0x15 0x00 0
