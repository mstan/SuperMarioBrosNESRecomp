# Exercise the wrapped top-edge representation used when the 32px player box
# rises above screen row zero. Keep SMB1 in ordinary player control while
# setting both its authoritative and screen-relative vertical coordinates.
WRITE_RAM8 00B5 00
WRITE_RAM8 00CE F8
WRITE_RAM8 03B8 F8
